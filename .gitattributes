# Automatically detect text and binary files
* text=auto

# Source code and configuration
*.java       text eol=lf
*.xml        text eol=lf
*.properties text eol=lf
*.sql        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf

# Unix scripts
*.sh         text eol=lf
mvnw         text eol=lf

# Windows scripts
*.cmd        text eol=crlf
*.bat        text eol=crlf
